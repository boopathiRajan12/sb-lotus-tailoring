# Copy this file to `.env` and fill in your Supabase project's values.
# `.env` is gitignored - never commit real credentials.

# ── Supabase database ────────────────────────────────────────────────────────
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Pick the "Session pooler" / port 5432 string unless you know you want the
# transaction pooler. Port 6543 also works and the app switches its connection
# pooling automatically, but session pooling is the simpler default for a
# long-running gunicorn process.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Alternative to the line above. Use this form when the password contains
# characters like @ / # ? - these get percent-encoded for you.
# SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.your-project-ref
# SUPABASE_DB_PASSWORD=your-password
# SUPABASE_DB_NAME=postgres

# ── App ──────────────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production - the app refuses to start
# without one, because a guessable key lets anyone forge an admin session.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Password for the admin account created on first startup. There is no default:
# if this is unset (or under 10 characters) no admin account is created, and the
# startup log says so. Set it, restart, then log in as `admin`.
ADMIN_PASSWORD=change-me-too

# Optional - the identity of that first admin account.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@sblotus.com

# Marks this as a real deployment: enables Secure cookies and HSTS, disables the
# debug server, and makes a missing/weak SECRET_KEY fatal. Set automatically on
# Render (which exports RENDER); set it by hand on any other host.
# PRODUCTION=true

# ── Optional ─────────────────────────────────────────────────────────────────
# Run db.create_all() and the startup column patches. Turn off once you manage
# the schema through supabase/schema.sql alone.
# DB_AUTO_CREATE=true

# SQLAlchemy pool sizing (ignored on port 6543, where pgbouncer pools instead).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=280
# DB_CONNECT_TIMEOUT=10

# Force HTTPS-only session cookies. On automatically in production.
# SESSION_COOKIE_SECURE=true
